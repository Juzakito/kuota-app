rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones helper de autenticación y propiedad
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // =========================================================================
    // 1. Colecciones de Configuración de Negocio (PRD §6.6 y AGENTS.md Regla 6)
    // Valores de negocio en config/*, nunca constantes en código.
    // Lectura permitida a usuarios autenticados; escritura SOLO admin/servidor.
    // =========================================================================
    match /config/{configDoc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 2. Usuarios y Resumen Consolidado (PRD §6.1 y AGENTS.md Regla 2)
    // El cliente NUNCA escribe dinero, cuotas, niveles ni saldos.
    // =========================================================================
    match /users/{userId} {
      // El usuario solo puede consultar y actualizar su propio perfil no financiero
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['level', 'maxCreditCents', 'availableCreditCents', 'riskScore', 'role']);
      allow delete: if false;

      // Resumen consolidado: Home en 1 lectura (PRD §6.1)
      // ESCRITURA TOTALMENTE DENEGADA AL CLIENTE (solo Cloud Functions 2ª gen)
      match /summary/current {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Borradores y datos temporales de KYC
      match /kyc_draft/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // =========================================================================
    // 3. Compras al Crédito y Cuotas (PRD §6.6 y AGENTS.md Regla 2)
    // ESCRITURA TOTALMENTE DENEGADA AL CLIENTE.
    // Solo Cloud Functions autorizadas escriben compras y cuotas.
    // =========================================================================
    match /purchases/{purchaseId} {
      // Lectura permitida solo al comprador o al proveedor involucrado
      allow read: if isAuthenticated() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.providerUid == request.auth.uid ||
        isAdmin()
      );
      // Escritura denegada al cliente
      allow write: if false;
    }

    match /installments/{installmentId} {
      // Lectura permitida solo al comprador o al proveedor de la compra
      allow read: if isAuthenticated() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.providerUid == request.auth.uid ||
        isAdmin()
      );
      // Escritura denegada al cliente
      allow write: if false;
    }

    // =========================================================================
    // 4. Ledger Contable de Doble Entrada y Payouts (PRD §6.6)
    // Inmutable, append-only, escrito exclusivamente desde el servidor.
    // =========================================================================
    match /ledger/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && (
        resource.data.providerUid == request.auth.uid || isAdmin()
      );
      allow write: if false;
    }

    // =========================================================================
    // 5. Proveedores y Catálogo Público (PRD §3 y §4)
    // Directorio público de proveedores para búsqueda y compra.
    // =========================================================================
    match /providers/{providerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 6. Lista de Espera (Waitlist Landings) - PRD §5
    // Registro público de leads con consentimiento Ley N° 29733.
    // =========================================================================
    match /waitlist/{leadId} {
      allow create: if request.resource.data.consent == true;
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // 7. Registro de Dispositivos y Notificaciones Push
    // =========================================================================
    match /devices/{deviceToken} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 8. Denegación estricta por defecto
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
